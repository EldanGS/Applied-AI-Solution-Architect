# Copy this file to `.env` and fill in your own keys:
#     cp .env.example .env
# `.env` is listed in .gitignore. Never commit it, paste it into a notebook,
# or show it on screen while recording/streaming.

# --- Anthropic (Claude) -------------------------------------------------------
# Create a key in the Claude Console: https://platform.claude.com/settings/keys
# Read automatically by the `anthropic` SDK and by the Claude Agent SDK.
ANTHROPIC_API_KEY=

# --- OpenAI -------------------------------------------------------------------
# Create a project key in the OpenAI dashboard: https://platform.openai.com/api-keys
# Read automatically by the `openai` and `openai-agents` SDKs.
OPENAI_API_KEY=

# --- Optional overrides used by the notebooks --------------------------------
# Default models for the notebooks. Change them here instead of editing code.
# Note: claude-haiku-4-5-20251001 is cheaper but does not support the `effort` setting.
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-6-luna
